# ==============================================================================
# Daily Dev Job Alerts — Environment Configuration
# ==============================================================================

# 1. Gmail SMTP Credentials
# Enter your Gmail address and 16-character App Password (NOT your login password)
# Generate App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=mushtaq.mdrizwan@gmail.com
GMAIL_APP_PASSWORD=m21Sht@q

# Recipient address where the daily digest should be sent
ALERT_RECIPIENT=mushtaq.mdrizwan@gmail.com

# 2. Google Cloud Storage Bucket (Used for serverless state deduplication in GCP)
# Create with: gcloud storage buckets create gs://daily-job-alerts-mushtaq --location=asia-south1
GCS_BUCKET_NAME=daily-job-alerts-mushtaq

# 3. Filtering and Alert Parameters
MIN_MATCH_SCORE=60
MAX_JOBS_PER_CATEGORY=8
